[TEMPLATE]
PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=7d

# AI Provider (at least one required for quiz generation)
# Groq is FREE — get key at https://console.groq.com
# Free-tier model (verified working): openai/gpt-oss-120b
# Llama models (llama-3.1-8b-instant, llama-3.3-70b-versatile) are
# Enterprise-only now and return 404 model_not_found on the free tier.
GROQ_API_KEY=
# xAI requires credits — get key at https://console.x.ai
XAI_API_KEY=

# Google OAuth (Required for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://eduvance-cbqy.onrender.com/api/auth/google/callback
