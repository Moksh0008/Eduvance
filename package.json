{
  "name": "eduvance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "client/server"
  ],
  "scripts": {
    "build": "npm run build -w eduvance-client",
    "start": "node client/server/server.js",
    "dev:client": "npm run dev -w eduvance-client",
    "dev:server": "npm run dev -w eduvance-server"
  }
}
